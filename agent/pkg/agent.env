# Copy these from the desk: Settings > Cloud agents. Then: sudo systemctl enable --now agenticops-agent
# and read the pairing code with: journalctl -u agenticops-agent
# DESK: the desk address. KEY: the value after --key. PIN: the value after sha256// in the download command.
DESK=https://DESK-ADDRESS:7377
KEY=
PIN=
# Optional name the desk shows for this machine.
NAME=
