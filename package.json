{
  "name": "agenticops-desk",
  "version": "0.1.76",
  "private": true,
  "author": "AgenticOp-io",
  "license": "Apache-2.0",
  "description": "Desktop workspace for AI coding agents.",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/patch-vite-electron.mjs && vite",
    "build": "tsc --noEmit && node --max-old-space-size=6144 node_modules/vite/bin/vite.js build && electron-builder --publish never",
    "pack": "tsc --noEmit && node --max-old-space-size=6144 node_modules/vite/bin/vite.js build && electron-builder --publish never",
    "test": "node --experimental-strip-types --test electron/gate.test.ts electron/healHistory.test.ts electron/memoryPath.test.ts electron/tarMember.test.ts electron/redact.test.ts electron/pureFeatures.test.ts electron/fleetCore.test.ts electron/trainData.test.ts electron/recallCore.test.ts src/transcript.test.ts src/autocorrect.test.ts src/helpText.test.ts mobile/github.test.ts boot/choice.test.mjs scripts/eval/lib.test.mjs",
    "preview": "vite preview",
    "postinstall": "node scripts/patch-vite-electron.mjs",
    "smoke": "node scripts/smoke.mjs",
    "ios": "vite build --config mobile/vite.config.ts && cap sync ios",
    "android": "vite build --config mobile/vite.config.ts && cap sync android && cd android && .\\gradlew.bat assembleDebug"
  },
  "build": {
    "appId": "io.agenticop.desk",
    "productName": "AgenticOps Desk",
    "asar": false,
    "files": [
      "boot/boot.mjs",
      "boot/choice.mjs",
      "build/icon.png",
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "electron/cursor-plugin",
        "to": "cursor-plugin"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "NOTICE",
        "to": "NOTICE"
      },
      {
        "from": "NOTICE",
        "to": "NOTICE"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "AgenticOps-Desk-${version}-win-${arch}-portable.${ext}"
    },
    "artifactName": "AgenticOps-Desk-${version}-${os}-${arch}.${ext}",
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "include": "build/installer.nsh",
      "artifactName": "AgenticOps-Desk-${version}-win-${arch}-setup.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "identity": "-"
    },
    "dmg": {
      "artifactName": "AgenticOps-Desk-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "maintainer": "AgenticOp-io <opensource@agenticop.io>",
      "synopsis": "Desktop workspace for AI coding agents"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libasound2t64 | libasound2"
      ]
    },
    "toolsets": {
      "appimage": "1.0.3"
    },
    "extraMetadata": {
      "main": "boot/boot.mjs"
    },
    "afterPack": "scripts/afterPack.cjs"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.319",
    "@anthropic-ai/sdk": "^1.6.0",
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.3",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@monaco-editor/react": "^4.7.0",
    "@types/node": "^22.15.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.0.12",
    "jsqr": "^1.4.0",
    "katex": "^0.19.1",
    "monaco-editor": "^0.57.0",
    "openai": "^7.53.0",
    "playwright-core": "^1.65.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.4",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "zod": "^4.6.7"
  },
  "homepage": "https://agenticop.io"
}
